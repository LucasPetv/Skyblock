{
    "name": "skyblock/assistant",
    "description": "Hypixel SkyBlock Ironman Progression Assistant",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "SkyBlock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SkyBlock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap tests/bootstrap.php --testdox"
    }
}
